# ── Core ────────────────────────────────────────────────────────────────
# Local docker-compose MySQL default:
DATABASE_URL=mysql://longform:longform@localhost:3306/longform
# REQUIRED. Signs the session cookie AND derives the AES key that encrypts
# provider keys stored in the database (app_settings). There is no default —
# the app throws rather than encrypting under a published secret. Rotating it
# logs everyone out AND makes every stored APIMART/HeyGen/69Labs key
# undecryptable (re-enter them in Admin → Provider Keys).
JWT_SECRET=
# Single admin login
ADMIN_EMAIL=
ADMIN_PASSWORD=
PORT=3000

# ── AI providers ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# gpt-image-2 stills + b-roll keyframes (direct api.openai.com)
OPENAI_API_KEY=

# ── Cloudflare R2 (S3 API) ──────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL of the bucket. Also where music beds live (music/beds/<channelKey>/,
# see the README); unset = narration-only films.
R2_PUBLIC_URL=

# ── RunPod (whisperx transcription + optional self-hosted host lip-sync) ─
RUN_POD_KEY=
# Deploy kodxana/whisperx-worker_v2 as a serverless endpoint and put its ID here.
RUNPOD_WHISPERX_ENDPOINT=
# Self-hosted InfiniteTalk host lip-sync — the alternative to HeyGen below. Deploy
# Metropolis-Media/infinitetalk-runpod-hub (80GB GPU, container disk 200GB+, execution
# timeout 3600s+) and put its endpoint ID here. Setting it alone changes NOTHING: the
# host lane only moves once LIPSYNC_PROVIDER=runpod, so the endpoint stays testable.
# RUNPOD_INFINITETALK_ENDPOINT=
# LIPSYNC_PROVIDER=heygen        # heygen (default) | runpod
# RUNPOD_LIPSYNC_QUALITY=fast    # fast = 8-step distill | full = 40 steps + real CFG, ~10x the cost
# RUNPOD_LIPSYNC_CONCURRENCY=4   # keep near the endpoint's max-workers; RunPod queues the rest
# RUNPOD_LIPSYNC_EXECUTION_TIMEOUT_MS=2400000 # per-job GPU cap sent with EVERY submit (40 min),
#                                # overriding the endpoint's own setting. The dashboard default is
#                                # 20 min, and a 720p host beat over ~4 s of speech needs more than
#                                # that on an A40 — it was killed on every attempt and resubmitted
#                                # forever. A render stopped at this cap fails its scene for good.
# RUNPOD_LIPSYNC_TIMEOUT_MS=2100000 # client poll ceiling per attempt (35 min); a poll that runs out
#                                # returns pending and the resume path keeps collecting
# LIPSYNC_RESOLUTION=720p        # RunPod lane render size, 720p everywhere by default (480p = cheap
#                                # experiments only; it no longer silently drops to 480p on a dev box)
# RUNPOD_LIPSYNC_INPUT=image     # image = host photo (I2V) | video = static plate (V2V), pins the
#                                # camera so it cannot drift; Admin -> Provider Keys stores the live value
# RUNPOD_LIPSYNC_V2V_STEPS=16    # pinned-mode anchor dial: active steps = steps - start_step (app default 16/4).
# RUNPOD_LIPSYNC_SHIFT=4         # motion dials, any mode, OVERRIDE ONLY (workflow defaults rule when unset):
# RUNPOD_LIPSYNC_AUDIO_SCALE=0.8 #  shift = how far a frame may wander from the photo (2 = official recipe);
# RUNPOD_LIPSYNC_AUDIO_CFG=2     #  audio_scale = how hard the voice drives motion; audio_cfg (pinned default 2) ~2x GPU;
# RUNPOD_LIPSYNC_NAG_SCALE=11    #  nag_scale = negative-prompt strength on the fast tier
# RUNPOD_LIPSYNC_SCHEDULER=euler #  sampler; deterministic (euler, flowmatch_distill) = less shimmer than dpm++_sde
# RUNPOD_LIPSYNC_MOTION_FRAME=25 #  frames carried across 81-frame windows; raise (37, 49) if the person snaps at a boundary
# RUNPOD_LIPSYNC_FETA_WEIGHT=2   #  Enhance-A-Video strength (0 = off)
# RUNPOD_LIPSYNC_LEAD_SEC=2      #  run-up trimmed off each host clip so it never opens cold (0 = off); +2s GPU/scene
# RUNPOD_LIPSYNC_V2V_START_STEP=4 # OVERRIDE ONLY — the app defaults to 4 of 16 (the measured 75% ratio).
#                                # more active = freer motion; keep the ratio if you change steps

# ── Host lip-sync (HeyGen Avatar IV, 1080p 16:9, ~$0.067/s) ─────────────
# Fallback key; per-tab keys are stored (encrypted) via the Admin UI.
HEYGEN_API_KEY=
# Contextual host plates: 1 = render host scenes onto a generated 16:9 frame of the host IN
# the scene's setting, instead of the raw studio headshot. The lip-sync model animates the
# image it is given and never changes the background, so without this the host stands against
# the headshot's backdrop for the whole film.
# HOST_PLATES=1
# HOST_PLATE_LOOKS=4           # distinct settings per film; host beats share a look's plate
# Public origin of this server (e.g. https://myapp.example.com) — used for the HeyGen
# render-completion webhook. Blank locally ⇒ pure polling (still works).
PUBLIC_BASE_URL=

# ── Webstore sales callback (see server/salesWebhook.ts) ───────────────
# Shared secret the webstore sends as `x-sales-secret` on POST /api/sales when
# a payment clears, so a video's earnings show beside the video. Must be the
# SAME value in both apps. Generate with: openssl rand -hex 32
#
# UNSET ⇒ /api/sales rejects every request with 503. That is deliberate: an
# open sales endpoint would let anyone invent revenue. Nothing else in the
# pipeline depends on it — tracking links and QR codes are generated either way.
SALES_SECRET=

# ── AIReiter bolt-on (TEMPORARY — see server/providers/aireiter.ts) ─────
# Spends prepaid AIReiter credits on b-roll clips and/or stills instead of
# APIMART/OpenAI. Leave AIREITER_LANES blank to keep everything as-is.
# AIReiter has NO lip-sync and NO TTS, so host scenes and narration are never
# affected — those stay on HeyGen and 69Labs.
AIREITER_API_KEY=
AIREITER_LANES=                    # blank (off) | broll | stills | broll,stills | all
# AIREITER_VIDEO_RESOLUTION=720p   # 480p is roughly half the price
# AIREITER_IMAGE_RESOLUTION=2K     # 1K | 2K | 4K
# AIREITER_CONCURRENCY=4           # spend governor — every slot is a billed generation

# ── Optional tuning (defaults in server/_core/env.ts) ───────────────────
# FFMPEG_PATH=            # custom ffmpeg binary; must support drawtext
# SIXTYNINE_VIDEO_CONCURRENCY=8
# SIXTYNINE_IMAGE_CONCURRENCY=7
# HEYGEN_CONCURRENCY=8
# IMAGE_PRIMARY_TIMEOUT_MS=480000
# IMAGE_PRIMARY_RETRIES=1
# IMAGE_RETRY_TIMEOUT_MS=240000
# IMAGE_RETRY_TOTAL_BUDGET_MS=600000

# ── Cost breakdown rates (server/pricing.ts) ───────────────────────────
# The "Cost" dialog on each long-form tab meters every billable call a render
# makes — real token counts, images, and seconds of rendered video, retries and
# discarded attempts included. Those QUANTITIES are always exact.
#
# The RATES below are what turn them into dollars, and only Anthropic publishes
# one: HeyGen, 69Labs, APIMART and AIReiter all sell credit bundles whose dollar
# value depends on your plan. So Claude lines are badged EXACT and priced to the
# cent, and everything else is badged ESTIMATED using the defaults below.
#
# Check one invoice per provider, set the matching var, and that lane becomes
# accurate for you. A provider with no rate at all shows "rate not set" in the
# dialog rather than $0.00 — a missing rate is never silently treated as free.
#
# COST_HEYGEN_PER_SEC=0.06         # per second of host video (1080p costs the same as 720p)
# COST_APIMART_IMAGE=0.02          # per gpt-image-2 still/keyframe (quality=high)
# COST_APIMART_VIDEO_PER_SEC=0.02  # per second of grok-imagine b-roll
# COST_OPENAI_IMAGE=0.003          # OpenAI-direct fallback, 1280x720 quality=low
# COST_AIREITER_IMAGE=0.02         # AIReiter bolt-on — same models as the APIMART lane it
# COST_AIREITER_VIDEO_PER_SEC=0.02 # replaces, so these default to the APIMART rates
# COST_69LABS_IMAGE=0.05
# COST_69LABS_VIDEO_PER_SEC=0.05
# COST_GEMINI_IMAGE=0.03           # near-dead image fallback lane
# COST_TTS_PER_1K_CHARS=0.05       # 69Labs narration, per 1,000 characters of script
# COST_WHISPERX_PER_GPU_SEC=0.0004 # RunPod serverless, billed on its own executionTime
# COST_RUNPOD_LIPSYNC_PER_GPU_SEC=0.00097 # self-hosted InfiniteTalk. Per GPU SECOND, not per
#                                  # second of video: divide your endpoint's $/hr by 3600
#                                  # (default = a 96GB Blackwell at $3.49/hr)
#
# Not covered by the dialog, because they aren't per-model API fees: R2 storage
# and egress, and ffmpeg assembly (both run on your own infrastructure).

# NOTE: 69Labs + APIMART API keys are NOT env vars — enter them in the Admin
# UI; they are AES-encrypted and stored in the database.
