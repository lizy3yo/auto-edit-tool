# ── Core ────────────────────────────────────────────────────────────────
# Local docker-compose MySQL default:
DATABASE_URL=mysql://longform:longform@localhost:3306/longform
# REQUIRED. Signs the session cookie AND derives the AES key that encrypts
# provider keys stored in the database (app_settings). There is no default —
# the app throws rather than encrypting under a published secret. Rotating it
# logs everyone out AND makes every stored APIMART/HeyGen/69Labs key
# undecryptable (re-enter them in Admin → Provider Keys).
JWT_SECRET=
# Single admin login
ADMIN_EMAIL=
ADMIN_PASSWORD=
PORT=3000

# ── AI providers ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# gpt-image-2 stills + b-roll keyframes (direct api.openai.com)
OPENAI_API_KEY=

# ── Cloudflare R2 (S3 API) ──────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL of the bucket. Also where music beds live (music/beds/<channelKey>/,
# see the README); unset = narration-only films.
R2_PUBLIC_URL=

# ── RunPod (whisperx word-level transcription for narration alignment) ──
RUN_POD_KEY=
# Deploy kodxana/whisperx-worker_v2 as a serverless endpoint and put its ID here.
RUNPOD_WHISPERX_ENDPOINT=

# ── HeyGen host lip-sync ────────────────────────────────────────────────
LIPSYNC_PROVIDER=heygen
# Fallback key; per-tab keys are stored (encrypted) via the Admin UI.
HEYGEN_API_KEY=
# Public origin of this server (e.g. https://myapp.example.com) — used for the
# HeyGen render-completion webhook. Blank locally ⇒ pure polling (still works).
PUBLIC_BASE_URL=

# ── Optional tuning (defaults in server/_core/env.ts) ───────────────────
# FFMPEG_PATH=            # custom ffmpeg binary; must support drawtext
# SIXTYNINE_VIDEO_CONCURRENCY=8
# SIXTYNINE_IMAGE_CONCURRENCY=7
# HEYGEN_CONCURRENCY=8
# IMAGE_PRIMARY_TIMEOUT_MS=480000
# IMAGE_PRIMARY_RETRIES=1
# IMAGE_RETRY_TIMEOUT_MS=240000
# IMAGE_RETRY_TOTAL_BUDGET_MS=600000

# NOTE: 69Labs + APIMART API keys are NOT env vars — enter them in the Admin
# UI; they are AES-encrypted and stored in the database.
